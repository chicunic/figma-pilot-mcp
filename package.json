{
  "name": "figma-pilot-mcp",
  "version": "0.2.0",
  "description": "An MCP server that gives AI full control over Figma — read, create, and modify designs.",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "dev:ws": "bun run --watch src/server.ts --mode=ws",
    "dev:mcp": "bun run --watch src/server.ts --mode=mcp",
    "start": "bun run src/server.ts",
    "start:ws": "bun run src/server.ts --mode=ws",
    "start:mcp": "bun run src/server.ts --mode=mcp",
    "build": "bunx esbuild src/plugin/code.ts --bundle --outfile=dist/plugin/code.js --target=es2018 --format=iife && cp src/plugin/manifest.json src/plugin/ui.html dist/plugin/",
    "typecheck": "tsc --noEmit && tsc -p src/plugin/tsconfig.json",
    "lint": "biome check src",
    "lint:fix": "biome check src --write"
  },
  "keywords": [
    "figma",
    "figma-plugin",
    "mcp",
    "model-context-protocol",
    "ai",
    "design-automation"
  ],
  "author": "chicunic",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@figma/plugin-typings": "^1.123.0",
    "@types/bun": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
